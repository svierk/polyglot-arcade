{
  "name": "polyglot-arcade",
  "private": true,
  "version": "0.4.0",
  "description": "Retro arcade on the Salesforce Platform showing Salesforce Multi-Framework: an Angular hub, a React cabinet and an LWC microfrontend host sharing CRM data.",
  "author": {
    "name": "Sebastiano Schwarz",
    "url": "https://github.com/svierk"
  },
  "license": "MIT",
  "engines": {
    "node": "24.x.x"
  },
  "scripts": {
    "sf-project-setup": "node scripts/sf-project-setup.mjs",
    "build": "echo 'No build required for base-sfdx-project'",
    "clean": "echo 'No clean required for base-sfdx-project'",
    "lint": "eslint --no-error-on-unmatched-pattern **/{aura,lwc}/**/*.js",
    "validate:org-setup-config": "node scripts/validate-org-setup-config.mjs",
    "test": "npm run test:unit",
    "test:coverage": "npm run test",
    "test:unit": "sfdx-lwc-jest -- --passWithNoTests",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,mjs,json,md,page,trigger,ts,tsx,xml,yaml,yml}\"",
    "prettier:verify": "prettier --check \"**/*.{cls,cmp,component,css,html,js,mjs,json,md,page,trigger,ts,tsx,xml,yaml,yml}\"",
    "precommit": "lint-staged",
    "setup": "node scripts/org-setup.mjs",
    "dev:preview": "node scripts/org-setup-dev.mjs",
    "connect:cabinet": "node scripts/connect-cabinet.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.9.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.3.0",
    "@prettier/plugin-xml": "^3.2.2",
    "@sa11y/jest": "^8.2.1",
    "@salesforce/eslint-config-lwc": "^4.1.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.1",
    "eslint": "^9.39.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jest": "^28.8.1",
    "husky": "^9.1.5",
    "lint-staged": "^17.6.0",
    "prettier": "^3.1.0",
    "prettier-plugin-apex": "^2.0.1"
  }
}
