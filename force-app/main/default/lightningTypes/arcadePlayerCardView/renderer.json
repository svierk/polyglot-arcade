{
  "renderer": {
    "componentOverrides": {
      "$": {
        "definition": "@widget/c/arcadePlayerCardWidget",
        "attributes": {
          "player": "{!$attrs.player}",
          "initials": "{!$attrs.initials}",
          "rounds": "{!$attrs.rounds}",
          "gamesPlayed": "{!$attrs.gamesPlayed}",
          "gamesTotal": "{!$attrs.gamesTotal}",
          "hasRounds": "{!$attrs.hasRounds}",
          "message": "{!$attrs.message}",
          "bests": "{!$attrs.bests}",
          "recent": "{!$attrs.recent}"
        }
      }
    }
  }
}
